#!/bin/sh
# Finalize the macOS look inside the image. The heavy lifting (downloading +
# installing the WhiteSur theme/icons/wallpaper) is done on the host by
# stage-theme.sh and copied in via includes.chroot; here we just refresh
# caches and provide a fallback wallpaper if none was staged.
set -x

# refresh icon caches for the installed WhiteSur icon themes
for d in /usr/share/icons/WhiteSur /usr/share/icons/WhiteSur-dark; do
    [ -d "$d" ] && gtk-update-icon-cache -f "$d" 2>/dev/null || true
done

# fallback wallpaper: Sonoma-ish gradient if staging didn't provide one
mkdir -p /usr/share/backgrounds/macos
if [ ! -f /usr/share/backgrounds/macos/sonoma.jpg ]; then
    convert -size 1920x1080 gradient:'#1e3a8a'-'#7c3ac8' \
        /usr/share/backgrounds/macos/sonoma.jpg 2>/dev/null || true
fi

exit 0
